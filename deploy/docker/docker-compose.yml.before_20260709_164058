services:
  db:
    image: postgres:16
    container_name: z115_db
    env_file:
      - .env.production
    volumes:
      - postgres_data:/var/lib/postgresql/data
    ports:
      - "127.0.0.1:5432:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $$POSTGRES_USER -d $$POSTGRES_DB"]
      interval: 10s
      timeout: 5s
      retries: 10
    restart: unless-stopped

  web:
    build:
      context: ../..
      dockerfile: deploy/docker/Dockerfile
    image: z115-backoffice-web:20260709_133202-nomigrate
    container_name: z115_web
    env_file:
      - .env.production
    depends_on:
      db:
        condition: service_healthy
    volumes:
      - staticfiles:/app/staticfiles
      - /opt/z115-backoffice/data/media:/app/media
    command: >
      sh -c "
      python manage.py migrate &&
      python manage.py collectstatic --noinput &&
      gunicorn appserver.wsgi:application --bind 0.0.0.0:8000 --workers 2 --timeout 120
      "
    restart: unless-stopped

  nginx:
    image: nginx:stable
    container_name: z115_nginx
    depends_on:
      - web
    ports:
      - "80:80"
    volumes:
      - staticfiles:/staticfiles:ro
      - /opt/z115-backoffice/data/media:/media:ro
      - ./nginx/default.conf:/etc/nginx/conf.d/default.conf:ro
    restart: unless-stopped

volumes:
  postgres_data:
  staticfiles:
