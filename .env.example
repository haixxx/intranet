# =========================================
# Django Intranet - file cấu hình mẫu
# Copy file này thành .env hoặc thiết lập biến môi trường tương ứng trên server.
# Lưu ý: project hiện chưa tự đọc .env nếu chưa cài python-dotenv/django-environ.
# Khi chạy production, cần set các biến này trong môi trường hệ điều hành/service.
# =========================================

# Django
DJANGO_ENV=dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret-key
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.100

# CSRF - thêm IP/hostname nội bộ dùng để truy cập web
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://192.168.1.100

# Database
# Dev có thể dùng SQLite: USE_POSTGRES=False
# Chạy chính thức nên dùng PostgreSQL: USE_POSTGRES=True
USE_POSTGRES=False
DB_NAME=intranet_db
DB_USER=intranet_user
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Static/media
STATIC_ROOT=staticfiles
MEDIA_ROOT=media

# Module legacy attendance_devices v1
# Mặc định tắt để tránh người dùng/API đi nhầm module cũ.
ENABLE_ATTENDANCE_DEVICES_V1=False

# Celery beat
# Mặc định tắt vì chưa triển khai Celery/Redis ở giai đoạn chuẩn hóa nền.
ENABLE_CELERY_BEAT=False

# Attendance devices v2 / Agent
ATT_AGENT_RATE_LIMIT_PER_HOUR=300
ATT_RAW_EVENTS_MAX_BATCH_SIZE=2000
ATT_HMAC_WIN_SECONDS=300
ATT_HMAC_WIN_CLIENT_01=replace-with-strong-secret-hex-or-base64
