+{% extends "backoffice/base.html" %}
+{% load i18n %}
+{% block title %}{% trans "Hồ sơ" %}{% endblock %}
+{% block content %}
+<div class="bo-page-header">
+  <div class="bo-page-heading">
+    <div class="bo-page-pretitle">{% trans "Tài khoản" %}</div>
+    <h2 class="bo-page-title"><i class="ti ti-user"></i>{% trans "Hồ sơ cá nhân" %}</h2>
+    <div class="bo-page-subtitle">{% trans "Xem thông tin tài khoản và cập nhật thông tin cá nhân." %}</div>
+  </div>
+  <div class="bo-page-actions">
+    <a href="{% url 'backoffice:dashboard' %}" class="btn btn-outline-secondary btn-sm"><i class="ti ti-arrow-left"></i>{% trans "Về tổng quan" %}</a>
+  </div>
+</div>
+
+<div class="card bo-card mb-3">
+  <div class="card-body">
+    <div class="row g-3">
+      <div class="col-md-4">
+        <div class="bo-kpi-label">{% trans "Tên đăng nhập" %}</div>
+        <div class="fw-semibold">{{ user_obj.username }}</div>
+      </div>
+      <div class="col-md-4">
+        <div class="bo-kpi-label">{% trans "Họ tên" %}</div>
+        <div class="fw-semibold">{{ user_obj.full_name|default:"—" }}</div>
+      </div>
+      <div class="col-md-4">
+        <div class="bo-kpi-label">{% trans "Email" %}</div>
+        <div class="fw-semibold">{{ user_obj.email|default:"—" }}</div>
+      </div>
+    </div>
+  </div>
+</div>
+
+<form method="post" class="card bo-form-card">
+  {% csrf_token %}
+  <div class="card-header">
+    <h3 class="card-title mb-0">{% trans "Cập nhật thông tin" %}</h3>
+  </div>
+  <div class="card-body">
+    {{ form.non_field_errors }}
+
+    <div class="bo-form-grid">
+      <div>
+        <label class="form-label" for="{{ form.full_name.id_for_label }}">{{ form.full_name.label }}</label>
+        {{ form.full_name }}
+        {% for error in form.full_name.errors %}
+          <div class="text-danger small">{{ error }}</div>
+        {% endfor %}
+      </div>
+
+      <div>
+        <label class="form-label" for="{{ form.email.id_for_label }}">{{ form.email.label }}</label>
+        {{ form.email }}
+        {% for error in form.email.errors %}
+          <div class="text-danger small">{{ error }}</div>
+        {% endfor %}
+      </div>
+
+      <div class="bo-form-field-full">
+        <div class="form-check form-switch">
+          {{ form.change_password }}
+          <label class="form-check-label ms-2" for="id_change_password">{% trans "Đổi mật khẩu" %}</label>
+        </div>
+      </div>
+    </div>
+
+    <div id="pw_fields" class="bo-js-hidden mt-3">
+      <div class="bo-form-grid">
+        <div>
+          <label class="form-label" for="{{ form.new_password.id_for_label }}">{{ form.new_password.label }}</label>
+          {{ form.new_password }}
+          <div class="form-text">{% trans "Mật khẩu tối thiểu 6 ký tự." %}</div>
+          {% for error in form.new_password.errors %}
+            <div class="text-danger small">{{ error }}</div>
+          {% endfor %}
+        </div>
+
+        <div>
+          <label class="form-label" for="{{ form.confirm_password.id_for_label }}">{{ form.confirm_password.label }}</label>
+          {{ form.confirm_password }}
+          {% for error in form.confirm_password.errors %}
+            <div class="text-danger small">{{ error }}</div>
+          {% endfor %}
+        </div>
+      </div>
+    </div>
+  </div>
+  <div class="card-footer bo-form-actions">
+    <button class="btn btn-primary"><i class="ti ti-device-floppy"></i>{% trans "Lưu thay đổi" %}</button>
+    <a href="{% url 'backoffice:dashboard' %}" class="btn btn-outline-secondary">{% trans "Bỏ qua" %}</a>
+  </div>
+</form>
+{% endblock %}
+
+{% block extra_js %}
+<script>
+  (function() {
+    const cb = document.getElementById('id_change_password');
+    const pwBox = document.getElementById('pw_fields');
+    function togglePw() {
+      if (!pwBox || !cb) return;
+      pwBox.classList.toggle('bo-js-hidden', !cb.checked);
+    }
+    if (cb) {
+      cb.addEventListener('change', togglePw);
+      togglePw();
+    }
+  })();
+</script>
+{% endblock %}
