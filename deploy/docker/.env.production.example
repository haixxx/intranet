# =========================================================
# Z115 Backoffice - Production environment example
# Copy this file to .env.production and change values.
# DO NOT commit real .env.production.
# =========================================================

# Django
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-this-secret-key
ALLOWED_HOSTS=192.168.1.100,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://192.168.1.100

# Database selection
USE_POSTGRES=True

# Django database connection
DB_NAME=z115_backoffice
DB_USER=z115_user
DB_PASSWORD=change-this-db-password
DB_HOST=db
DB_PORT=5432
DB_CONN_MAX_AGE=60

# PostgreSQL container initialization
POSTGRES_DB=z115_backoffice
POSTGRES_USER=z115_user
POSTGRES_PASSWORD=change-this-db-password

# Optional paths inside container
STATIC_ROOT=staticfiles
MEDIA_ROOT=media
